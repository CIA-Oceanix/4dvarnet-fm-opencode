@incollection{duygulu_object_2002,
	title = {Object {Recognition} as {Machine} {Translation}: {Learning} a {Lexicon} for a {Fixed} {Image} {Vocabulary}},
	shorttitle = {Object {Recognition} as {Machine} {Translation}: {Learning} a {Lexicon} for a {Fixed} {Image} {Vocabulary}},
	url = {citeulike-article-id:2719889 http://dx.doi.org/10.1007/3-540-47979-1_7},
	abstract = {We describe a model of object recognition as machine translation. In this model, recognition is a process of annotating image regions with words. Firstly, images are segmented into regions, which are classified into region types using a variety of features. A mapping between region types and keywords supplied with the images, is then learned, using a method based around EM. This process is analogous with learning a lexicon from an aligned bitext. For the implementation we describe, these words are nouns taken from a large vocabulary. On a large test set, the method can predict numerous words with high accuracy. Simple methods identify words that cannot be predicted well. We show how to cluster words that individually are difficult to predict into clusters that can be predicted well â€” for example, we cannot predict the distinction between train and locomotive using the current set of features, but we can predict the underlying concept. The method is trained on a substantial collection of images. Extensive experimental results illustrate the strengths and weaknesses of the approach.},
	booktitle = {Proc. {Eur}. {Conf}. on {Computer} {Vision}, {ECCV} 2002, {LNCS} 2350},
	author = {Duygulu, P. and Barnard, K. and de Freitas, J. and Forsyth, D.},
	year = {2002},
	keywords = {c-bag-of-features, s-collected, t-imaging},
	pages = {349--354},
}

