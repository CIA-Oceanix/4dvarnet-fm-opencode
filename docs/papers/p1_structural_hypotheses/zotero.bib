@article{alvera-azcarate_multivariate_2007,
	title = {Multivariate reconstruction of missing data in sea surface temperature, chlorophyll, and wind satellite fields},
	volume = {112},
	doi = {10.1029/2006JC003660},
	abstract = {An empirical orthogonal function?based technique called Data Interpolating Empirical Orthogonal Functions (DINEOF) is used in a multivariate approach to reconstruct missing data. Sea surface temperature (SST), chlorophyll a concentration, and QuikSCAT winds are used to assess the benefit of a multivariate reconstruction. In particular, the combination of SST plus chlorophyll, SST plus lagged SST plus chlorophyll, and SST plus lagged winds have been studied. To assess the quality of the reconstructions, the reconstructed SST and winds have been compared to in situ data. The combination of SST plus chlorophyll, as well as SST plus lagged SST plus chlorophyll, significantly improves the results obtained by the reconstruction of SST alone. All the experiments correctly represent the SST, and an upwelling/downwelling event in the West Florida Shelf reproduced by the reconstructed data is studied.},
	number = {C3},
	journal = {JGR},
	author = {Alvera-Azcárate, A. and Barth, A. and Beckers, J.-M. and Weisberg, R. H.},
	year = {2007},
	keywords = {empirical orthogonal functions, missing data, multivariate reconstruction},
}

