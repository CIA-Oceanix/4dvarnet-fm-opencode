@article{carpenter_migration_2003,
	title = {Migration of a {Late} {Cretaceous} fish},
	volume = {423},
	issn = {0028-0836},
	shorttitle = {Migration of a {Late} {Cretaceous} fish},
	url = {://WOS:000182561600040},
	doi = {10.1038/nature01588},
	abstract = {Late Cretaceous sediments from the Western Interior of North America yield exceptionally well preserved fossils(1,2) that serve as proxies for the rapidly changing climate preceding the Cretaceous/ Tertiary boundary (about 67-65 Myr ago)(3,4). Here we reconstruct the ontogenetic history of a Maastrichtian-age fish, Vorhisia vulpes(5), by using the carbon, oxygen and strontium isotope ratios of four aragonite otoliths collected from the Fox Hills Formation of South Dakota. Individuals of V. vulpes spawned in brackish water (about 70-80\% seawater) and during their first year migrated to open marine waters of the Western Interior Seaway, where they remained for 3 years before returning to the estuary, presumably to spawn and die. The mean delta(18)O from the marine growth phase of V. vulpes yields a seawater temperature of 18 degreesC, which is consistent with leaf physiognomy and general-circulation-model temperature estimates for the Western Interior during the latest Maastrichtian(4,6,7).},
	journal = {Nature},
	author = {Carpenter, S. J. and Erickson, J. M. and Holland, F. D.},
	year = {2003},
	note = {6935},
	pages = {70--74},
}

