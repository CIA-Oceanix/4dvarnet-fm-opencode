	title = {A {Dynamical}-{Statistical} {Approach} to {Retrieve} the {Ocean} {Interior} {Structure} {From} {Surface} {Data}: {SQG}-{mEOF}-{R}},
	volume = {125},
	issn = {2169-9291},
