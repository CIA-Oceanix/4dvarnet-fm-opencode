@article{fablet_joint_2016,
	title = {Joint {Interpolation} of {Multisensor} {Sea} {Surface} {Temperature} {Fields} {Using} {Nonlocal} and {Statistical} {Priors}},
	volume = {9},
	issn = {1939-1404},
	doi = {10.1109/JSTARS.2016.2523605},
	abstract = {This paper addresses the joint analysis of multisource and multiresolution remote sensing data for the interpolation of high-resolution sea surface geophysical fields. As case-study application, we consider the interpolation of sea surface temperature (SST) fields. We propose a novel statistical model that combines two key features: an exemplar-based prior and statistical priors. The exemplar-based prior, referred to as a nonlocal prior, exploits similarities between local patches (small field regions) to interpolate missing data areas from previously observed exemplars. This nonlocal prior also sets an explicit conditioning between the multisensor data. Two complementary statistical priors, namely a prior on the spatial covariance and a prior on the marginal distribution of the high-resolution details, are considered as sea surface geophysical fields that are expected to depict specific spectral and marginal features in relation to the underlying turbulent ocean dynamics. We report the experiments on both synthetic and real SST data. These experiments demonstrate the contributions of the proposed combination of nonlocal and statistical priors to interpolate visually consistent and geophysically sound SST fields from multisource satellite data. We further discuss the key features and parameterizations of this model as well as its relevance with respect to classical interpolation techniques.},
	number = {6},
	journal = {IEEE Journal of Selected Topics in Applied Earth Observations and Remote Sensing},
	author = {Fablet, R. and Rousseau, F.},
	month = jun,
	year = {2016},
	keywords = {Data models, Exemplar-based texture models, Remote sensing, Sea surface, Spatial resolution, geophysical techniques, geophysically sound sea surface temperature fields, high-resolution detail marginal distribution, high-resolution sea surface geophysical field interpolation, inpainting, interpolation, joint analysis, missing data interpolation, model parameterizations, multiresolution remote sensing data, multisensor data, multisensor sea surface temperature field interpolation, multisource remote sensing data, non-local models, nonlocal prior, ocean remote sensing, ocean temperature, sea surface fields, spatial covariance, statistical analysis, statistical model, statistical prior, turbulence, turbulent ocean dynamics},
	pages = {2665--2675},
}

@article{fablet_shedding_2011,
	title = {Shedding {Light} on {Fish} {Otolith} {Biomineralization} {Using} a {Bioenergetic} {Approach}},
	volume = {6},
	issn = {1932-6203},
	url = {http://journals.plos.org/plosone/article?id=10.1371/journal.pone.0027055},
	doi = {10.1371/journal.pone.0027055},
	abstract = {Otoliths are biocalcified bodies connected to the sensory system in the inner ears of fish. Their layered, biorhythm-following formation provides individual records of the age, the individual history and the natural environment of extinct and living fish species. Such data are critical for ecosystem and fisheries monitoring. They however often lack validation and the poor understanding of biomineralization mechanisms has led to striking examples of misinterpretations and subsequent erroneous conclusions in fish ecology and fisheries management. Here we develop and validate a numerical model of otolith biomineralization. Based on a general bioenergetic theory, it disentangles the complex interplay between metabolic and temperature effects on biomineralization. This model resolves controversial issues and explains poorly understood observations of otolith formation. It represents a unique simulation tool to improve otolith interpretation and applications, and, beyond, to address the effects of both climate change and ocean acidification on other biomineralizing organisms such as corals and bivalves.},
	number = {11},
	urldate = {2016-10-06},
	journal = {PLOS ONE},
	author = {Fablet, R. and Pecquerie, L. and Pontual, H. de and Høie, H. and Millner, R. and Mosegaard, H. and Kooijman, S.A.L.M.},
	year = {2011},
	keywords = {Aragonite, Bioenergetics, Biomineralization, Fish physiology, Metabolic processes, Opacity, Otolith, Simulation and modeling},
	pages = {e27055},
}

