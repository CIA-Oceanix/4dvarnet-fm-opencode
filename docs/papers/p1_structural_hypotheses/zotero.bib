@inproceedings{he_single_2011,
	title = {Single image super-resolution using {Gaussian} process regression},
	doi = {10.1109/CVPR.2011.5995713},
	abstract = {In this paper we address the problem of producing a high-resolution image from a single low-resolution image without any external training set. We propose a framework for both magnification and deblurring using only the original low-resolution image and its blurred version. In our method, each pixel is predicted by its neighbors through the Gaussian process regression. We show that when using a proper covariance function, the Gaussian process regression can perform soft clustering of pixels based on their local structures. We further demonstrate that our algorithm can extract adequate information contained in a single low-resolution image to generate a high-resolution image with sharp edges, which is comparable to or even superior in quality to the performance of other edge-directed and example-based super-resolution algorithms. Experimental results also show that our approach maintains high-quality performance at large magnifications.},
	booktitle = {{IEEE} {Conf}. on {Computer} {Vision} and {Pattern} {Recognition}, {CVPR}'11},
	author = {He, H. and Siu, W. C.},
	month = jun,
	year = {2011},
	keywords = {Equations, Gaussian process regression, Gaussian processes, Ground penetrating radar, Image edge detection, Mathematical model, Strontium, Training, covariance function, edge-directed super-resolution algorithms, example-based super-resolution algorithms, image deblurring, image resolution, image restoration, original low-resolution image, pattern clustering, regression analysis, single image super resolution, soft clustering},
	pages = {449--456},
}

@article{beckers_eof_2003,
	title = {{EOF} {Calculations} and {Data} {Filling} from {Incomplete} {Oceanographic} {Datasets}},
	volume = {20},
	issn = {0739-0572},
	abstract = {The paper presents a new self-consistent method to infer missing data from oceanographic data series and to extract the relevant empirical orthogonal functions. As a by-product, the new method allows for the detection of the number of statistically significant EOFs by a cross-validation procedure for a complete or incomplete dataset, as well as the noise level and interpolation error. Since the proposed filling and analysis method does not need a priori information about the error covariance structure, the method is self-consistent and parameter free.},
